<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Yashintv — Live Scores & News</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link href='https://fonts.googleapis.com/css2?family=Exo+2:wght@700;800&family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@600;700&family=Rubik:wght@700&display=swap' rel='stylesheet'/>
<style is:inline>
/* ================= RESET & BASE ================= */
* { margin: 0; padding: 0; box-sizing: border-box; }
*::-webkit-scrollbar { display: none; }

html { scroll-behavior: auto; } /* FIX: was 'smooth' — caused jump-to-top on refresh */

:root {
  --bg: #f4f6f9;
  --surface: #ffffff;
  --text: #1f2937;
  --text-muted: #6b7280;
  --border: #e5e7eb;
  --border-hi: #d1d5db;
  --primary: #4338ca; 
  --primary-gradient: linear-gradient(135deg, #159AFA 0%, #316DF7 35%, #5550F4 65%, #942CF3 100%);
  --shadow: 0 4px 12px rgba(0,0,0,.06);
  --radius: 12px;
  --nav-height: 70px;
  --container-width: 1280px;
}
body.dark {
  --bg: #0f1115;
  --surface: #1a1d23;
  --text: #f3f4f6;
  --text-muted: #9ca3af;
  --border: #2d3139;
  --border-hi: #4b5563;
  --shadow: 0 4px 12px rgba(0,0,0,.3);
}
body {
  font-family: 'Inter', system-ui, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
  transition: background .3s, color .3s;
  padding-top: var(--nav-height);
  overflow-x: hidden;
}

/* ================= STICKY NAV ================= */
.navbar-wrapper {
  position: fixed; top: 0; left: 0; right: 0;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  z-index: 1000;
  display: flex;
  justify-content: center;
}
.navbar {
  width: 100%;
  max-width: var(--container-width);
  height: var(--nav-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 2rem;
  gap: 1rem;
}
.navbar-left { display: flex; align-items: center; text-decoration: none; line-height: 1; }
.logo-text {
  font-family: 'Rubik', sans-serif;
  font-size: 1.7rem;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: -1px;
  -webkit-text-stroke: 2.5px #111111;
  paint-order: stroke fill;
  text-shadow: 2px 2px 0 #111111;
}
body.dark .logo-text {
  -webkit-text-stroke: 2px #ffffff;
  text-shadow: 2px 2px 0 #ffffff;
  color: #111111;
}
.navbar-right { display: flex; align-items: center; gap: 1.5rem; }
.nav-links { display: flex; align-items: center; gap: 1.8rem; }
.nav-links a {
  color: #343435;
  text-decoration: none;
  font-family: 'Inter', sans-serif;
  font-weight: 500;
  font-size: 0.8rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  transition: color .2s, transform .15s ease;
  -webkit-tap-highlight-color: transparent;
  padding: 6px 12px;
  border-radius: 8px;
}
body.dark .nav-links a { color: #d1d5db; }
.nav-links a i { font-size: 0.8rem; color: #a5b4fc; transition: color .2s; }
.nav-links a:hover { color: var(--primary); background: rgba(67, 56, 202, 0.08); transform: translateY(-1px); }
.nav-links a:hover i { color: var(--primary); }
body.dark .nav-links a:hover { color: #c7d2fe; background: rgba(129, 140, 248, 0.12); }
body.dark .nav-links a:hover i { color: #818cf8; }
.nav-links a.active { color: #4338ca; font-weight: 600; background: rgba(67, 56, 202, 0.08); }
body.dark .nav-links a.active { color: #818cf8; background: rgba(129, 140, 248, 0.12); }

.theme-toggle {
  width: 40px; height: 40px; border-radius: 50%;
  background: var(--bg);
  border: 1px solid var(--border);
  color: var(--text);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; font-size: .95rem;
  transition: .2s;
  -webkit-tap-highlight-color: transparent;
}
.theme-toggle:hover { border-color: var(--primary); color: var(--primary); background: rgba(67, 56, 202, 0.06); }

.mobile-menu-btn {
  display: none;
  width: 44px; height: 44px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  color: var(--text);
  font-size: 1.2rem;
  cursor: pointer;
  align-items: center;
  justify-content: center;
  -webkit-tap-highlight-color: transparent;
  outline: none;
  transition: background .15s, border-color .15s;
}
.mobile-menu-btn:focus { outline: none; }
.mobile-menu-btn:active, .mobile-menu-btn:hover {
  background: var(--surface);
  border-color: var(--border-hi);
  -webkit-tap-highlight-color: transparent;
}

/* ================= MOBILE SIDEBAR ================= */
.sidebar-overlay {
  position: fixed; inset: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(2px);
  z-index: 1001;
  opacity: 0; visibility: hidden;
  transition: opacity 0.35s ease, visibility 0.35s ease;
  -webkit-tap-highlight-color: transparent;
}
.sidebar-overlay.active { opacity: 1; visibility: visible; }

.mobile-sidebar {
  position: fixed; top: 0; right: 0;
  width: 60%; max-width: 85vw; height: 100vh;
  background: var(--surface);
  z-index: 1002;
  box-shadow: -5px 0 25px rgba(0,0,0,0.15);
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex; flex-direction: column;
  padding: 0; gap: 0;
  will-change: transform;
  -webkit-tap-highlight-color: transparent;
}
.mobile-sidebar.active { transform: translateX(0); }

.mobile-sidebar-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
  background: var(--surface);
  flex-shrink: 0; min-height: 64px;
}
.mobile-sidebar-header .logo-text { font-size: 1.3rem; -webkit-text-stroke: 2px #111111; text-shadow: 1.5px 1.5px 0 #111111; }
body.dark .mobile-sidebar-header .logo-text { -webkit-text-stroke: 1.8px #ffffff; text-shadow: 1.5px 1.5px 0 #ffffff; color: #111111; }
.mobile-sidebar-close {
  background: none; border: none; color: var(--text); font-size: 1.2rem;
  cursor: pointer; -webkit-tap-highlight-color: transparent; outline: none;
  padding: 4px 8px; border-radius: 6px; transition: background .15s; line-height: 1;
}
.mobile-sidebar-close:hover { background: var(--bg); }

.mobile-sidebar-body {
  flex: 1; overflow-y: auto; padding: 16px;
  display: flex; flex-direction: column; gap: 4px;
  -webkit-overflow-scrolling: touch;
}

.drawer-menu-item {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 16px;
  color: var(--text); font-size: 15px; font-weight: 500;
  border-radius: 8px; cursor: pointer;
  transition: background .2s, color .2s;
  text-decoration: none;
  -webkit-tap-highlight-color: transparent;
}
.drawer-menu-item i { font-size: 14px; width: 20px; text-align: center; color: var(--text-muted); transition: color .2s; }
.drawer-menu-item:hover { background: rgba(67, 56, 202, 0.06); color: var(--primary); }
.drawer-menu-item:hover i { color: var(--primary); }
body.dark .drawer-menu-item:hover { background: rgba(129, 140, 248, 0.1); color: #818cf8; }
body.dark .drawer-menu-item:hover i { color: #818cf8; }

.drawer-divider { height: 1px; background: var(--border); margin: 8px 16px; flex-shrink: 0; }

.mobile-theme-btn {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 16px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--text);
  font-weight: 600; font-size: 15px;
  cursor: pointer; -webkit-tap-highlight-color: transparent;
  outline: none; width: 100%;
  transition: background .15s, border-color .15s;
  text-align: left;
}
.mobile-theme-btn:hover, .mobile-theme-btn:active { background: var(--surface); border-color: var(--border-hi); }
.mobile-theme-btn i { font-size: 14px; width: 20px; text-align: center; color: var(--primary); }
body.dark .mobile-theme-btn i { color: #818cf8; }

.mobile-sidebar-footer { padding: 16px; border-top: 1px solid var(--border); flex-shrink: 0; }
.mobile-cta-btn {
  display: flex; align-items: center; justify-content: center; gap: 8px;
  width: 100%; padding: 12px 16px;
  background: #25D366; color: #fff;
  font-weight: 600; font-size: 15px;
  border: none; border-radius: 8px;
  cursor: pointer; text-decoration: none;
  transition: opacity .2s, transform .15s;
  -webkit-tap-highlight-color: transparent;
}
.mobile-cta-btn:hover { opacity: 0.9; transform: translateY(-1px); }
.mobile-cta-btn i { font-size: 16px; }

/* ================= MAIN LAYOUT ================= */
.container {
  max-width: var(--container-width);
  margin: 0 auto;
  padding: 1.5rem 2rem 3rem;
  display: grid;
  grid-template-columns: 1fr 320px;
  gap: 2rem;
  align-items: start;
  width: 100%;
}

.main-content { min-width: 0; width: 100%; }

.matches-section { background: transparent; border-radius: 0; padding: 0; box-shadow: none; width: 100%; }
.matches-section * { transition: background-color .3s, color .3s, border-color .3s; }

.matches-section {
  --primary-color: #2563eb;
  --secondary-color: #1e40af;
  --text-primary: #1f2937;
  --text-secondary: #6b7280;
  --bg-primary: #ffffff;
  --bg-secondary: #f9fafb;
  --bg-card: #ffffff;
  --border-color: #e5e7eb;
  --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  --brand-blue-bright: #159AFA;
  --brand-blue-medium: #316DF7;
  --brand-indigo: #5550F4;
  --brand-purple: #942CF3;
  --brand-white: #FBFAFD;
  --brand-accent: var(--brand-blue-medium);
  --brand-gradient: linear-gradient(135deg, #159AFA 0%, #316DF7 35%, #5550F4 65%, #942CF3 100%);
}
body.dark .matches-section {
  --primary-color: #41B375 !important;
  --secondary-color: #2d8e5a !important;
  --text-primary: #fffdfc !important;
  --text-secondary: #989b9f !important;
  --bg-primary: #1e1e1e !important;
  --bg-secondary: #2d2d30 !important;
  --bg-card: #252526 !important;
  --border-color: #4b5563 !important;
  --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3) !important;
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.3) !important;
}

.matches-section .container { max-width: 100%; margin: 0 auto; padding: 0; display: block; width: 100%; }
.matches-section .join-telegram-btn {
  display: flex; align-items: center; justify-content: center; gap: 9px;
  min-height: 42px; margin-bottom: 14px; padding: 0 16px;
  background-image: linear-gradient(135deg, #2AABEE 0%, #229ED9 100%); color: #ffffff;
  font-family: 'Montserrat', sans-serif; font-size: 0.95rem; font-weight: 700; letter-spacing: 0.2px;
  text-decoration: none; border-radius: 10px; box-shadow: 0 4px 10px rgba(34, 158, 217, 0.4);
  transition: box-shadow 0.25s ease, transform 0.2s ease; width: 100%;
}
.matches-section .join-telegram-btn:hover { box-shadow: 0 6px 16px rgba(34, 158, 217, 0.5); transform: translateY(-1px); }
.matches-section .join-telegram-btn .tg-icon { width: 20px; height: 20px; flex-shrink: 0; }
.matches-section .sport-tabs { display: flex; gap: 10px; margin-bottom: 28px; width: 100%; }
.matches-section .sport-tab {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 8px;
  min-height: 42px; padding: 0 10px;
  border: 1px solid var(--border-color); background: transparent; color: var(--text-secondary);
  font-family: 'Montserrat', sans-serif; font-size: 0.95rem; font-weight: 600;
  border-radius: 10px; cursor: pointer;
  transition: background-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  -webkit-tap-highlight-color: transparent; outline: none;
}
.matches-section .sport-tab i { font-size: 0.9rem; }
.matches-section .sport-tab:hover { color: var(--text-primary); }
.matches-section .sport-tab.active { background-image: var(--brand-gradient); border-color: transparent; color: #ffffff; box-shadow: 0 4px 10px rgba(49, 109, 247, 0.4); }
.matches-section .sport-section { scroll-margin-top: 90px; margin-bottom: 20px; width: 100%; }
.matches-section .heading-wrapper { margin-bottom: 30px; text-align: center; width: 100%; }
.matches-section .section-subtitle {
  font-family: 'Montserrat', sans-serif; font-size: 1.2rem; font-weight: 600;
  margin-top: 15px; margin-bottom: 25px;
  color: white; min-height: 42px; padding: 0 20px;
  display: flex; align-items: center;
  background-color: var(--brand-accent); background-image: var(--brand-gradient);
  border-radius: 10px; border: none; box-shadow: 0 4px 10px rgba(49, 109, 247, 0.4);
  width: 100%; text-align: left;
}
.matches-section .matches-grid { display: grid; grid-template-columns: 1fr; gap: 20px; margin-bottom: 20px; scroll-margin-top: 90px; min-height: auto; align-items: unset; justify-items: unset; width: 100%; }
.matches-section .match-card {
  background: var(--bg-secondary); border-radius: 15px;
  padding-top: 33px; padding-bottom: 13px;
  box-shadow: var(--shadow);
  transition: box-shadow 0.3s ease, border-color 0.3s ease, background-color 0.3s ease;
  border: 1px solid var(--border-color);
  cursor: pointer; position: relative; overflow: hidden; transform: translateZ(0);
  display: grid; grid-template-columns: 1fr auto 1fr; grid-template-rows: auto auto;
  align-items: stretch; justify-items: center; gap: 5px 10px; width: 100%;
}
.matches-section .match-card:hover { box-shadow: var(--shadow-lg); border-color: var(--border-hi); }
.matches-section .match-card::before { content: ''; position: absolute; inset: 0; background-color: rgba(0, 0, 0, 0); border-radius: 15px; transition: background-color 0.3s ease; z-index: 1; }
.matches-section .match-card:hover::before { background-color: rgba(0, 0, 0, 0.4); }
.matches-section .play-button {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) translateZ(0);
  background: white; color: var(--brand-accent); border: none; border-radius: 50%;
  width: 36px; height: 36px;
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; opacity: 0; visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease; z-index: 3; pointer-events: none;
  box-shadow: 0 4px 15px rgba(49, 109, 247, 0.6);
}
.matches-section .match-card:hover .play-button { opacity: 1; visibility: visible; }
.matches-section .vs-status-cell { grid-row: 1; grid-column: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 5px; min-width: 0; overflow: hidden; }
.matches-section .vs-text { font-size: 17px; font-weight: 700; color: var(--text-secondary); margin-bottom: 2px; line-height: 27px; max-width: 100px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.matches-section .vs-text.vs-time { font-size: 12.5px; line-height: 27px; color: var(--brand-accent); letter-spacing: 0.2px; }
.matches-section .team-info-wrapper { display: flex; flex-direction: column; align-items: center; text-align: center; justify-content: flex-start; padding: 0 5px; min-width: 0; max-width: 100%; overflow: hidden; }
.matches-section .team-info-wrapper:nth-of-type(1) { grid-column: 1; grid-row: 1; }
.matches-section .team-info-wrapper:nth-of-type(2) { grid-column: 3; grid-row: 1; }
.matches-section .match-time-cell { grid-row: 2; grid-column: 1 / -1; display: flex; flex-direction: row; align-items: center; justify-content: center; padding-top: 5px; gap: 10px; min-width: 0; overflow: hidden; width: 100%; }
.matches-section .team-logo-container { width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 8px; }
.matches-section .team-logo-img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
.matches-section .team-logo-text { width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: bold; color: var(--brand-accent); background-color: var(--bg-secondary); }
.matches-section .team-name { font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 15px; letter-spacing: 0.2px; line-height: 1.3; max-width: 100%; min-height: 1.2em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; }
.matches-section .status-text { display: inline-block; padding: 3px 8px; border-radius: 15px; font-size: 11px; font-weight: 600; white-space: nowrap; margin-bottom: 1px; }
.matches-section .match-type { color: var(--brand-accent); font-size: 12px; font-weight: 600; max-width: 160px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: inline-block; vertical-align: middle; }
.matches-section .match-time { color: var(--brand-accent); font-size: 13px; min-height: 1.2em; font-weight: 600; max-width: 240px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: inline-block; vertical-align: middle; }
.matches-section .match-time.live-format { font-size: 12px; }
.matches-section .status-live { display: inline-flex; align-items: center; gap: 5px; background: rgba(239, 68, 68, 0.12); color: #ef4444; }
.matches-section .status-live::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #ef4444; animation: pulse-dot 1.3s ease-in-out infinite; }
.matches-section .status-upcoming { background: #10b981; color: white; }
.matches-section .status-ended { display: inline-flex; align-items: center; gap: 5px; background: rgba(107, 114, 128, 0.16); color: var(--text-secondary); }
.matches-section .status-ended::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--text-secondary); }
@keyframes pulse-dot { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.65); } }
.matches-section .no-matches-message { text-align: center; font-family: 'Inter', sans-serif; font-size: 1.3rem; font-weight: 600; color: var(--text-secondary); padding: 25px 0; display: flex; align-items: center; justify-content: center; width: 100%; }
.matches-section .load-more-sentinel { height: 1px; background-color: transparent; margin: 20px 0; visibility: hidden; pointer-events: none; }

@media (max-width: 480px) {
  .matches-section .sport-tabs { gap: 6px; }
  .matches-section .join-telegram-btn { min-height: 38px; font-size: 0.85rem; padding: 0 12px; }
  .matches-section .sport-tab { font-size: 0.8rem; min-height: 38px; padding: 0 6px; gap: 5px; }
  .matches-section .section-subtitle { font-size: 1rem; min-height: 38px; padding: 0 14px; border-radius: 8px; }
  .matches-section .match-card { padding: 18px 10px 13px; }
  .matches-section .team-logo-container { width: 36px; height: 36px; }
  .matches-section .team-name { font-size: 13.5px; }
  .matches-section .vs-text { max-width: 70px; }
  .matches-section .match-type { max-width: 110px; }
  .matches-section .match-time { max-width: 150px; }
}

/* ================= NATIVE AD SLOT ================= */
.ad-banner-container {
  margin: 2rem 0;
  min-height: 100px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  overflow: hidden;
}

/* ================= LATEST BLOGS ================= */
.blogs-wrapper { margin-top: 0; }
.blogs-header { margin: 0 0 20px; padding: 0; width: 100%; display: block; }
.blogs-header h2 { font-size: 1.5rem; font-weight: 700; margin: 0; color: var(--text); }

.blogPts {
  display: block; width: 100%;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 0;
  box-shadow: 0 5px 35px rgba(0, 0, 0, .05);
  overflow: hidden;
}

.blogPts > .ntry {
  display: block; width: 100%; max-width: 100%;
  margin: 0; padding: 18px 25px;
  background: transparent;
  border: 0; border-bottom: 1px solid var(--border);
  border-radius: 0; box-shadow: none;
  transition: background .15s ease;
  position: relative;
  cursor: pointer;
}
.blogPts > .ntry:last-child { border-bottom: 0; }
.blogPts > .ntry:hover { background: #eaeaea; }
body.dark .blogPts > .ntry:hover { background: rgba(255, 255, 255, 0.08); }

.blogPts .pTtl {
  font-size: 1.1rem; font-weight: 700; line-height: 1.45;
  margin: 0 0 6px; color: var(--text);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  position: relative;
}
.blogPts .pTtl a { text-decoration: none; color: inherit; }
.blogPts > .ntry:hover .pTtl a { color: var(--primary); }

.blogPts .pSnpt {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 13.5px; line-height: 1.55;
  margin: 0 0 8px; opacity: .75;
  min-height: calc(1.55em * 2);
}

.blogPts .pInf {
  display: block; position: static;
  margin: 0; padding: 0;
  font-size: 12.5px; color: var(--text-muted); opacity: .75;
}
.blogPts .pInf::before { content: 'By Admin'; display: block; font-weight: 500; }

.blogPg {
  display: flex; justify-content: center;
  margin: -10px 0 30px !important;
  position: relative;
  width: calc(100% + 2px); left: -1px; right: -1px;
  border: 1px solid var(--border); border-top: 0;
  border-radius: 0 0 10px 10px;
  background: var(--surface);
  padding: 15px;
}
.blogPg > * {
  width: 100% !important; max-width: none;
  justify-content: center;
  background: #5a48f5; color: #fff !important;
  padding: 14px !important;
  font-size: 14px; font-weight: 600;
  border-radius: 8px !important;
  transition: all .2s ease;
  text-align: center;
  cursor: pointer;
}
.blogPg > *:hover { opacity: .9; }

@media screen and (max-width: 640px) {
  .blogPts > .ntry { padding: 12px 18px; }
