const SPORTS = {
    football: { url: 'https://football-feed.pages.dev/matchfeed.json' },
    cricket: { url: 'https://live-pages-be0.pages.dev/cricket-feed.json' },
    others: { url: 'https://live-pages-be0.pages.dev/other-feed.json' }
};
const state = { football: [], cricket: [], others: [] };
const loadedSports = new Set();
const FETCH_TIMEOUT_MS = 6000;

async function fetchMatches(sport) {
    const { url } = SPORTS[sport];
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), FETCH_TIMEOUT_MS);
    try {
        const response = await fetch(url, { signal: controller.signal, cache: 'no-store' });
        clearTimeout(timeoutId);
        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        const data = await response.json();
        state[sport] = (data.matches && Array.isArray(data.matches)) ? data.matches : (Array.isArray(data) ? data : []);
        try { localStorage.setItem(`matches_cache_${sport}`, JSON.stringify(state[sport])); } catch (e) {}
        return true;
    } catch (error) {
        clearTimeout(timeoutId);
        if (!state[sport] || state[sport].length === 0) state[sport] = [];
        return false;
    }
}
function renderFromCache(sport) {
    try {
        const cached = localStorage.getItem(`matches_cache_${sport}`);
        if (cached) {
            const parsed = JSON.parse(cached);
            if (Array.isArray(parsed) && parsed.length) { state[sport] = parsed; loadMatches(sport); }
        }
    } catch (e) {}
}
function parseDateString(dateString) {
    const parts = dateString.match(/(\d{2})\/(\d{2})\/(\d{2})\s(\d{2}):(\d{2}):(\d{2})/);
    if (!parts) return null;
    const year = parseInt(parts[1], 10) + 2000;
    const month = parseInt(parts[2], 10) - 1;
    const day = parseInt(parts[3], 10);
    const hours = parseInt(parts[4], 10);
    const minutes = parseInt(parts[5], 10);
    const seconds = parseInt(parts[6], 10);
    const OFFSET_MS = 345 * 60 * 1000;
    return new Date(Date.UTC(year, month, day, hours, minutes, seconds) - OFFSET_MS);
}
function formatLocalTime(date) {
    if (!date || isNaN(date.getTime())) return '';
    try { return date.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit', hour12: true }); } catch (e) { return ''; }
}
function updateCountdown(timeElement) {
    const targetDateString = timeElement.dataset.matchTime;
    const endHoursRaw = timeElement.dataset.endHours;
    const matchCard = timeElement.closest('.match-card');
    if (!matchCard) return;
    const statusElement = matchCard.querySelector('.status-text');
    const typeElement = matchCard.querySelector('.match-type');
    const startDate = targetDateString ? parseDateString(targetDateString) : null;
    const now = new Date();
    if (statusElement && statusElement.textContent === "LIVE") {
        if (typeElement) typeElement.style.display = 'none';
        timeElement.classList.add('live-format');
        const endHours = parseFloat(endHoursRaw);
        if (startDate && !isNaN(endHours)) {
            const endDate = new Date(startDate.getTime() + endHours * 60 * 60 * 1000);
            if (now.getTime() >= endDate.getTime()) {
                statusElement.textContent = 'Ended';
                statusElement.classList.remove('status-upcoming', 'status-live');
                statusElement.classList.add('status-ended');
                timeElement.textContent = '';
                timeElement.style.visibility = 'hidden';
                timeElement.classList.remove('live-format');
                if (typeElement) typeElement.style.display = '';
                timeElement.removeAttribute('data-match-time');
                timeElement.removeAttribute('data-end-hours');
                if (matchCard.parentNode) matchCard.parentNode.appendChild(matchCard);
            }
        }
        return;
    }
    if (statusElement && statusElement.textContent === "Ended") {
        timeElement.textContent = '';
        timeElement.classList.remove('live-format');
        return;
    }
    if (!targetDateString) return;
    if (!startDate) return;
    const distance = startDate.getTime() - now.getTime();
    if (distance < 0) {
        if (statusElement && statusElement.textContent !== "LIVE" && statusElement.textContent !== "Ended") {
            statusElement.textContent = "LIVE";
            statusElement.classList.remove('status-upcoming', 'status-ended');
            statusElement.classList.add('status-live');
            timeElement.textContent = matchCard.querySelector('.match-type')?.textContent || '';
            if (typeElement) typeElement.style.display = 'none';
            timeElement.classList.add('live-format');
            const vsTextEl = matchCard.querySelector('.vs-text');
            if (vsTextEl) { vsTextEl.textContent = 'VS'; vsTextEl.classList.remove('vs-time'); }
            if (matchCard.parentNode) matchCard.parentNode.insertBefore(matchCard, matchCard.parentNode.firstChild);
        }
        return;
    }
    const totalSeconds = Math.floor(distance / 1000);
    const days = Math.floor(totalSeconds / 86400);
    const hours = Math.floor((totalSeconds % 86400) / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;
    timeElement.textContent = `Live in ${days}d ${hours}h ${minutes}m ${seconds}s`;
    if (typeElement && typeElement.style.display === 'none') typeElement.style.display = '';
    timeElement.classList.remove('live-format');
}
function getStatusPriority(match) {
    const status = computeEffectiveStatus(match).toUpperCase();
    if (status === 'LIVE') return 1;
    if (status === 'UPCOMING') return 2;
    if (status === 'ENDED') return 3;
    return 2;
}
function sortMatchesByPriority(matchesArray) {
    return [...matchesArray].sort((a, b) => {
        const priorityA = getStatusPriority(a);
        const priorityB = getStatusPriority(b);
        if (priorityA !== priorityB) return priorityA - priorityB;
        if (priorityA === 2 && a.time && b.time) {
            const dateA = parseDateString(a.time);
            const dateB = parseDateString(b.time);
            if (dateA && dateB) return dateA.getTime() - dateB.getTime();
        }
        return 0;
    });
}
function shortenTeamName(name) { return name || ''; }
function computeEffectiveStatus(match) {
    const rawStatus = match.status || 'Upcoming';
    if (rawStatus === 'Ended') return 'Ended';
    const startDate = match.time ? parseDateString(match.time) : null;
    const hasEndTime = match.endTime !== undefined && match.endTime !== null && match.endTime !== '';
    const endHours = hasEndTime ? parseFloat(match.endTime) : NaN;
    const now = new Date();
    if (rawStatus === 'Upcoming') {
        if (startDate && now.getTime() >= startDate.getTime()) {
            if (!isNaN(endHours)) {
                const endDate = new Date(startDate.getTime() + endHours * 60 * 60 * 1000);
                if (now.getTime() >= endDate.getTime()) return 'Ended';
            }
            return 'LIVE';
        }
        return 'Upcoming';
    }
    if (rawStatus === 'LIVE') {
        if (startDate && !isNaN(endHours)) {
            const endDate = new Date(startDate.getTime() + endHours * 60 * 60 * 1000);
            if (now.getTime() >= endDate.getTime()) return 'Ended';
        }
        return 'LIVE';
    }
    return rawStatus;
}
function hashStr(s) {
    let h = 0;
    for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;
    return (h >>> 0).toString(36).slice(0, 5);
}
function getMatchSignature(match) {
    return [
        (match.team1 && match.team1.name) || '',
        (match.team2 && match.team2.name) || '',
        match.time || '',
        match.type || ''
    ].join('|');
}
const _matchIdMap = new WeakMap();
function assignUniqueMatchIds() {
    const used = new Set();
    for (const sport of Object.keys(state)) {
        for (const match of state[sport]) {
            if (!match) continue;
            let id;
            if (match.id) {
                id = String(match.id);
                if (used.has(id)) {
                    const suffix = hashStr(getMatchSignature(match));
                    let candidate = `${id}-${suffix}`;
                    let n = 2;
                    while (used.has(candidate)) { candidate = `${id}-${suffix}-${n++}`; }
                    id = candidate;
                }
            } else {
                const base = ((match.team1 && match.team1.name) || 'match')
                    .split(' ')[0].toLowerCase().replace(/[^a-z0-9]/g, '') || 'match';
                id = base;
                if (used.has(id)) {
                    const suffix = hashStr(getMatchSignature(match));
                    let candidate = `${base}-${suffix}`;
                    let n = 2;
                    while (used.has(candidate)) { candidate = `${base}-${suffix}-${n++}`; }
                    id = candidate;
                }
            }
            used.add(id);
            _matchIdMap.set(match, id);
        }
    }
}
function getUniqueMatchId(match) {
    return _matchIdMap.get(match) || (match.id ? String(match.id) : '');
}

function renderFullSortedGrid(sport, sortedMatchesArray) {
    assignUniqueMatchIds();
    const container = document.getElementById(`${sport}-matches`);
    const noMatchesDiv = document.getElementById(`${sport}-no-matches`);
    if (!container) return;
    if (!sortedMatchesArray.length) {
        container.style.display = 'none';
        if (noMatchesDiv) noMatchesDiv.style.display = 'flex';
        return;
    }
    container.style.display = 'grid';
    if (noMatchesDiv) noMatchesDiv.style.display = 'none';
    container.innerHTML = '';
    const fragment = document.createDocumentFragment();
    for (const match of sortedMatchesArray) {
        if (!match || !match.team1 || !match.team2) continue;
        const matchCard = document.createElement('div');
        matchCard.className = 'match-card';
        matchCard.addEventListener('click', (e) => {
            e.preventDefault();
            const matchId = getUniqueMatchId(match);
            if (!matchId) return;
            window.location.assign(`https://www.yashintv.xyz/p/match-details.html?id=${encodeURIComponent(matchId)}`);
        });
        const effectiveStatus = computeEffectiveStatus(match);
        const team1Wrapper = document.createElement('div');
        team1Wrapper.className = 'team-info-wrapper';
        const team1Logo = document.createElement('div');
        team1Logo.className = 'team-logo-container';
        const img1 = new Image();
        img1.loading = 'lazy';
        img1.src = match.team1.img;
        img1.className = 'team-logo-img';
        img1.onerror = function() {
            if (match.team1.img_fallback && this.src !== match.team1.img_fallback) { this.src = match.team1.img_fallback; }
            else { handleImageError(this, match.team1.code); }
        };
        team1Logo.appendChild(img1);
        team1Wrapper.appendChild(team1Logo);
        const team1Name = document.createElement('div');
        team1Name.className = 'team-name';
        team1Name.textContent = shortenTeamName(match.team1.name);
        team1Wrapper.appendChild(team1Name);
        matchCard.appendChild(team1Wrapper);
        const vsCell = document.createElement('div');
        vsCell.className = 'vs-status-cell';
        const vsText = document.createElement('div');
        vsText.className = 'vs-text';
        if (effectiveStatus === 'Upcoming' && match.time) {
            const startDateForVs = parseDateString(match.time);
            const localTimeLabel = formatLocalTime(startDateForVs);
            if (localTimeLabel) { vsText.textContent = localTimeLabel; vsText.classList.add('vs-time'); }
            else { vsText.textContent = 'VS'; }
        } else { vsText.textContent = 'VS'; }
        vsCell.appendChild(vsText);
        const statusSpan = document.createElement('div');
        let statusClass = effectiveStatus.toLowerCase();
        if (statusClass === 'live') statusClass = 'live';
        else if (statusClass === 'upcoming') statusClass = 'upcoming';
        else if (statusClass === 'ended') statusClass = 'ended';
        else statusClass = 'upcoming';
        statusSpan.className = `status-text status-${statusClass}`;
        statusSpan.textContent = effectiveStatus;
        vsCell.appendChild(statusSpan);
        matchCard.appendChild(vsCell);
        const team2Wrapper = document.createElement('div');
        team2Wrapper.className = 'team-info-wrapper';
        const team2Logo = document.createElement('div');
        team2Logo.className = 'team-logo-container';
        const img2 = new Image();
        img2.loading = 'lazy';
        img2.src = match.team2.img;
        img2.className = 'team-logo-img';
        img2.onerror = function() {
            if (match.team2.img_fallback && this.src !== match.team2.img_fallback) { this.src = match.team2.img_fallback; }
            else { handleImageError(this, match.team2.code); }
        };
        team2Logo.appendChild(img2);
        team2Wrapper.appendChild(team2Logo);
        const team2Name = document.createElement('div');
        team2Name.className = 'team-name';
        team2Name.textContent = shortenTeamName(match.team2.name);
        team2Wrapper.appendChild(team2Name);
        matchCard.appendChild(team2Wrapper);
        const timeCell = document.createElement('div');
        timeCell.className = 'match-time-cell';
        const typeDiv = document.createElement('div');
        typeDiv.className = 'match-type';
        if (sport === 'football') { typeDiv.textContent = '🏆 ' + (match.type || 'Match'); }
        else { typeDiv.textContent = match.type || 'Match'; }
        if (effectiveStatus === 'LIVE') typeDiv.style.display = 'none';
        timeCell.appendChild(typeDiv);
        const timeDiv = document.createElement('div');
        timeDiv.className = 'match-time';
        const hasEndTime = match.endTime !== undefined && match.endTime !== null && match.endTime !== '';
        if (effectiveStatus === 'Upcoming' && match.time) {
            timeDiv.setAttribute('data-match-time', match.time);
            if (hasEndTime) timeDiv.setAttribute('data-end-hours', match.endTime);
            timeDiv.textContent = 'Live in 0d 0h 0m 0s';
        } else if (effectiveStatus === 'LIVE') {
            timeDiv.textContent = match.type || 'LIVE';
            timeDiv.classList.add('live-format');
            if (match.time) timeDiv.setAttribute('data-match-time', match.time);
            if (hasEndTime) timeDiv.setAttribute('data-end-hours', match.endTime);
        } else if (effectiveStatus === 'Ended') {
            timeDiv.textContent = '';
            timeDiv.style.visibility = 'hidden';
        }
        timeCell.appendChild(timeDiv);
        matchCard.appendChild(timeCell);
        const playBtn = document.createElement('button');
        playBtn.className = 'play-button';
        playBtn.innerHTML = '<i class="fas fa-play"></i>';
        matchCard.appendChild(playBtn);
        fragment.appendChild(matchCard);
        if (match.time && (effectiveStatus === 'Upcoming' || effectiveStatus === 'LIVE')) {
            updateCountdown(timeDiv);
        }
    }
    container.appendChild(fragment);
}
function loadMatches(sport) {
    const grid = document.getElementById(`${sport}-matches`);
    const noMatchesDiv = document.getElementById(`${sport}-no-matches`);
    const sentinel = document.getElementById(`${sport}-sentinel`);
    const matches = state[sport];
    if (matches.length > 0) {
        if (grid) grid.style.display = 'grid';
        if (noMatchesDiv) noMatchesDiv.style.display = 'none';
        const sortedMatches = sortMatchesByPriority(matches);
        renderFullSortedGrid(sport, sortedMatches);
    } else {
        if (grid) grid.style.display = 'none';
        if (noMatchesDiv) noMatchesDiv.style.display = 'flex';
    }
    if (sentinel) sentinel.style.display = 'none';
}
async function loadSport(sport) {
    if (loadedSports.has(sport)) return;
    loadedSports.add(sport);
    renderFromCache(sport);
    const grid = document.getElementById(`${sport}-matches`);
    if (grid && state[sport].length === 0) {
        grid.style.display = 'grid';
        grid.innerHTML = '<div style="text-align:center; padding:40px; grid-column:1/-1;">Loading matches...</div>';
    }
    await fetchMatches(sport);
    loadMatches(sport);
}
async function loadAllSports() {
    await Promise.all(Object.keys(SPORTS).map(sport => loadSport(sport)));
}
function handleImageError(imgElement, teamCode) {
    imgElement.onerror = null;
    const fallbackDiv = document.createElement('div');
    fallbackDiv.className = 'team-logo-text';
    fallbackDiv.textContent = teamCode ? teamCode.toUpperCase() : '??';
    imgElement.parentNode.replaceChild(fallbackDiv, imgElement);
}
function setActiveTab(sport) {
    document.querySelectorAll('.sport-tab').forEach(tab => tab.classList.toggle('active', tab.dataset.sport === sport));
}
loadAllSports();
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.sport-tab').forEach(tab => {
        tab.addEventListener('click', () => {
            const sport = tab.dataset.sport;
            setActiveTab(sport);
            const target = document.getElementById(tab.dataset.target);
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    });
    setInterval(() => {
        document.querySelectorAll('.match-time[data-match-time]').forEach(timeEl => updateCountdown(timeEl));
    }, 1000);
});
</script>

<!-- ================= DYNAMIC BLOGS FEED ================= -->
<script is:inline>
(async function loadLatestBlogs() {
  const FEED = 'https://football-feed.pages.dev/blogs.json';
  const container = document.getElementById('latestBlogs');
  if (!container) return;

  try {
    const res = await fetch(FEED, { cache: 'no-store' });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const data = await res.json();
    const list = Array.isArray(data.latest) ? data.latest : (Array.isArray(data.all) ? data.all : []);

    if (!list.length) {
      container.innerHTML = '<div class="ntry"><div class="pCntn"><p class="pSnpt">No blogs yet.</p></div></div>';
      return;
    }

    container.innerHTML = list.slice(0, 5).map(b => {
      const raw = b.file || (b.slug + '.html');
      const cleaned = raw.replace(/^\/+/, '').replace(/^blogs\//, '').replace(/\.html$/, '');
      const href = 'blogs/' + cleaned;
      return `
        <div class="ntry" onclick="window.location.href='${href}'" style="cursor:pointer;">
          <div class="pCntn">
            <h3 class="pTtl"><a href="${href}">${esc(b.title || 'Untitled')}</a></h3>
            <p class="pSnpt">${esc(b.snippet || '')}</p>
            <div class="pInf"></div>
          </div>
        </div>`;
    }).join('');
  } catch (err) {
    container.innerHTML = '<div class="ntry"><div class="pCntn"><p class="pSnpt">Could not load blogs.</p></div></div>';
    console.error('Blogs fetch failed:', err);
  }

  function esc(s) {
    return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }
})();
</script>
</body>
