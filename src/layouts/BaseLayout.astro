---
const { title = 'Yashintv', description = '' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@600;700&family=Rubik:wght@700&display=swap" rel="stylesheet" />
  <style is:inline>
    :root {
      --bg: #f4f6f9; --surface: #ffffff; --text: #1f2937; --text-muted: #6b7280;
      --border: #e5e7eb; --border-hi: #d1d5db; --primary: #4338ca;
      --shadow: 0 4px 12px rgba(0,0,0,.06); --radius: 12px;
      --nav-height: 70px; --container-width: 1280px;
    }
    body.dark {
      --bg: #0f1115; --surface: #1a1d23; --text: #f3f4f6; --text-muted: #9ca3af;
      --border: #2d3139; --border-hi: #4b5563; --shadow: 0 4px 12px rgba(0,0,0,.3);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: auto; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--bg); color: var(--text);
      line-height: 1.6; padding-top: var(--nav-height);
      overflow-x: hidden; transition: background .3s, color .3s;
      min-height: 100vh; display: flex; flex-direction: column;
    }
    .layout-main { flex: 1 0 auto; }

    /* ===== NAV ===== */
    .navbar-wrapper {
      position: fixed; top: 0; left: 0; right: 0;
      background: var(--surface); border-bottom: 1px solid var(--border);
      z-index: 1000; display: flex; justify-content: center;
    }
    .navbar {
      width: 100%; max-width: var(--container-width); height: var(--nav-height);
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 2rem; gap: 1rem;
    }
    .navbar-left { display: flex; align-items: center; text-decoration: none; line-height: 1; }
    .logo-text {
      font-family: 'Rubik', sans-serif; font-size: 1.7rem; font-weight: 800;
      color: #ffffff; letter-spacing: -1px;
      -webkit-text-stroke: 2.5px #111111; paint-order: stroke fill;
      text-shadow: 2px 2px 0 #111111;
    }
    body.dark .logo-text {
      -webkit-text-stroke: 2px #ffffff; text-shadow: 2px 2px 0 #ffffff; color: #111111;
    }
    .navbar-right { display: flex; align-items: center; gap: 1.5rem; }
    .nav-links { display: flex; align-items: center; gap: 1.8rem; }
    .nav-links a {
      color: #343435; text-decoration: none; font-weight: 500; font-size: 0.8rem;
      display: flex; align-items: center; gap: 0.5rem; padding: 6px 12px;
      border-radius: 8px; transition: color .2s, transform .15s ease, background .2s;
      -webkit-tap-highlight-color: transparent;
    }
    body.dark .nav-links a { color: #d1d5db; }
    .nav-links a i { font-size: 0.8rem; color: #a5b4fc; transition: color .2s; }
    .nav-links a:hover { color: var(--primary); background: rgba(67, 56, 202, 0.08); transform: translateY(-1px); }
    .nav-links a:hover i { color: var(--primary); }
    body.dark .nav-links a:hover { color: #c7d2fe; background: rgba(129, 140, 248, 0.12); }
    body.dark .nav-links a:hover i { color: #818cf8; }
    .theme-toggle {
      width: 40px; height: 40px; border-radius: 50%; background: var(--bg);
      border: 1px solid var(--border); color: var(--text);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; font-size: .95rem; transition: .2s;
      -webkit-tap-highlight-color: transparent;
    }
    .theme-toggle:hover { border-color: var(--primary); color: var(--primary); background: rgba(67, 56, 202, 0.06); }
    .mobile-menu-btn {
      display: none; width: 44px; height: 44px; background: var(--bg);
      border: 1px solid var(--border); border-radius: 12px; color: var(--text);
      font-size: 1.2rem; cursor: pointer; align-items: center; justify-content: center;
      -webkit-tap-highlight-color: transparent; outline: none; transition: background .15s, border-color .15s;
    }
    .mobile-menu-btn:hover, .mobile-menu-btn:active { background: var(--surface); border-color: var(--border-hi); }

    /* ===== MOBILE SIDEBAR ===== */
    .sidebar-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(2px);
      z-index: 1001; opacity: 0; visibility: hidden;
      transition: opacity 0.35s ease, visibility 0.35s ease;
    }
    .sidebar-overlay.active { opacity: 1; visibility: visible; }
    .mobile-sidebar {
      position: fixed; top: 0; right: 0; width: 60%; max-width: 85vw; height: 100vh;
      background: var(--surface); z-index: 1002; box-shadow: -5px 0 25px rgba(0,0,0,0.15);
      transform: translateX(100%); transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
      display: flex; flex-direction: column; will-change: transform;
    }
    .mobile-sidebar.active { transform: translateX(0); }
    .mobile-sidebar-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: 16px 20px; border-bottom: 1px solid var(--border);
      background: var(--surface); flex-shrink: 0; min-height: 64px;
    }
    .mobile-sidebar-header .logo-text { font-size: 1.3rem; -webkit-text-stroke: 2px #111111; text-shadow: 1.5px 1.5px 0 #111111; }
    body.dark .mobile-sidebar-header .logo-text { -webkit-text-stroke: 1.8px #ffffff; text-shadow: 1.5px 1.5px 0 #ffffff; color: #111111; }
    .mobile-sidebar-close {
      background: none; border: none; color: var(--text); font-size: 1.2rem;
      cursor: pointer; padding: 4px 8px; border-radius: 6px; transition: background .15s; line-height: 1;
    }
    .mobile-sidebar-close:hover { background: var(--bg); }
    .mobile-sidebar-body { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 4px; }
    .drawer-menu-item {
      display: flex; align-items: center; gap: 12px; padding: 12px 16px;
      color: var(--text); font-size: 15px; font-weight: 500; border-radius: 8px;
      cursor: pointer; transition: background .2s, color .2s; text-decoration: none;
    }
    .drawer-menu-item i { font-size: 14px; width: 20px; text-align: center; color: var(--text-muted); }
    .drawer-menu-item:hover { background: rgba(67,56,202,0.06); color: var(--primary); }
    .drawer-menu-item:hover i { color: var(--primary); }
    body.dark .drawer-menu-item:hover { background: rgba(129,140,248,0.1); color: #818cf8; }
    .drawer-divider { height: 1px; background: var(--border); margin: 8px 16px; flex-shrink: 0; }
    .mobile-theme-btn {
      display: flex; align-items: center; gap: 12px; padding: 12px 16px;
      background: var(--bg); border: 1px solid var(--border); border-radius: 8px;
      color: var(--text); font-weight: 600; font-size: 15px; cursor: pointer;
      outline: none; width: 100%; text-align: left; transition: background .15s, border-color .15s;
    }
    .mobile-theme-btn:hover, .mobile-theme-btn:active { background: var(--surface); border-color: var(--border-hi); }
    .mobile-theme-btn i { font-size: 14px; width: 20px; text-align: center; color: var(--primary); }
    body.dark .mobile-theme-btn i { color: #818cf8; }
    .mobile-sidebar-footer { padding: 16px; border-top: 1px solid var(--border); flex-shrink: 0; }
    .mobile-cta-btn {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      width: 100%; padding: 12px 16px; background: #25D366; color: #fff;
      font-weight: 600; font-size: 15px; border: none; border-radius: 8px;
      cursor: pointer; text-decoration: none; transition: opacity .2s, transform .15s;
    }
    .mobile-cta-btn:hover { opacity: 0.9; transform: translateY(-1px); }

    /* ===== FOOTER ===== */
    .site-footer { background: var(--surface); border-top: 1px solid var(--border); padding: 3rem 0 1.5rem; margin-top: 2rem; flex-shrink: 0; }
    .footer-inner { max-width: var(--container-width); margin: 0 auto; padding: 0 2rem; }
    .footer-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-bottom: 2rem; }
    .footer-col h4 { font-size: 0.9rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem; color: var(--text); }
    .footer-col a { display: block; color: var(--text-muted); text-decoration: none; font-size: 0.85rem; padding: 0.4rem 0; transition: .2s; }
    .footer-col a:hover { color: #5a48f5; transform: translateX(2px); }
    .footer-bottom { border-top: 1px solid var(--border); padding-top: 1.5rem; text-align: center; color: var(--text-muted); font-size: 0.85rem; font-weight: 500; }

    @media (max-width: 768px) {
      .navbar { padding: 0 1.2rem; }
      .nav-links { display: none; }
      .theme-toggle { display: none; }
      .mobile-menu-btn { display: flex; }
      .footer-grid { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    }
    @media (max-width: 480px) { .footer-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <div class="navbar-wrapper">
    <nav class="navbar">
      <a href="/" class="navbar-left"><div class="logo-text">Yashintv</div></a>
      <div class="navbar-right">
        <div class="nav-links">
          <a href="/#football-section"><i class="fa-regular fa-circle-dot"></i> Football</a>
          <a href="/#cricket-section"><i class="fa-regular fa-circle-dot"></i> Cricket</a>
          <a href="/#others-section"><i class="fa-solid fa-gear"></i> Tools</a>
          <a href="/blogs"><i class="fa-regular fa-file-lines"></i> Articles</a>
        </div>
        <button class="theme-toggle" id="themeToggleDesktop" aria-label="Toggle dark mode"><i class="fas fa-moon"></i></button>
        <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Menu"><i class="fas fa-bars"></i></button>
      </div>
    </nav>
  </div>

  <div class="sidebar-overlay" id="sidebarOverlay"></div>
  <div class="mobile-sidebar" id="mobileSidebar">
    <div class="mobile-sidebar-header">
      <div class="logo-text">Yashintv</div>
      <button class="mobile-sidebar-close" id="mobileSidebarClose"><i class="fas fa-times"></i></button>
    </div>
    <div class="mobile-sidebar-body">
      <button class="mobile-theme-btn" id="themeToggleMobile"><i class="fas fa-moon"></i> Dark Mode</button>
      <div class="drawer-divider"></div>
      <a href="/#football-section" class="drawer-menu-item"><i class="fa-regular fa-circle-dot"></i> Football</a>
      <a href="/#cricket-section" class="drawer-menu-item"><i class="fa-regular fa-circle-dot"></i> Cricket</a>
      <a href="/#others-section" class="drawer-menu-item"><i class="fa-solid fa-gear"></i> Tools</a>
      <a href="/blogs" class="drawer-menu-item"><i class="fa-regular fa-file-lines"></i> Articles</a>
    </div>
    <div class="mobile-sidebar-footer">
      <a href="https://t.me/yaminetv_tg" target="_blank" rel="noopener" class="mobile-cta-btn"><i class="fab fa-telegram"></i> Join Telegram</a>
    </div>
  </div>

  <div class="layout-main">
    <slot />
  </div>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-grid">
        <div class="footer-col">
          <h4>Socials</h4>
          <a href="#"><i class="fab fa-telegram"></i> Telegram</a>
          <a href="#"><i class="fab fa-youtube"></i> YouTube</a>
          <a href="#"><i class="fab fa-instagram"></i> Instagram</a>
          <a href="#"><i class="fab fa-facebook"></i> Facebook</a>
        </div>
        <div class="footer-col">
          <h4>Sports</h4>
          <a href="/#cricket-section">Cricket</a>
          <a href="/#football-section">Football</a>
          <a href="/#football-section">EPL</a>
          <a href="/#football-section">La Liga</a>
          <a href="/#others-section">Others</a>
        </div>
        <div class="footer-col">
          <h4>Support</h4>
          <a href="#">Contact Us</a>
          <a href="#">About Us</a>
          <a href="#">DMCA</a>
          <a href="#">Disclaimer</a>
          <a href="#">Privacy Policy</a>
        </div>
      </div>
      <div class="footer-bottom" id="footerText"></div>
    </div>
  </footer>

  <script is:inline>
    if ('scrollRestoration' in history) history.scrollRestoration = 'auto';
    document.getElementById('footerText').innerHTML = `© ${new Date().getFullYear()} Yashintv`;

    const themeToggleDesktop = document.getElementById('themeToggleDesktop');
    const themeToggleMobile = document.getElementById('themeToggleMobile');
    const themeIconDesktop = themeToggleDesktop.querySelector('i');

    function applyTheme(isDark) {
      document.body.classList.toggle('dark', isDark);
      themeIconDesktop.classList.toggle('fa-moon', !isDark);
      themeIconDesktop.classList.toggle('fa-sun', isDark);
      if (themeToggleMobile) {
        themeToggleMobile.innerHTML = isDark
          ? '<i class="fas fa-sun"></i> Light Mode'
          : '<i class="fas fa-moon"></i> Dark Mode';
      }
    }
    applyTheme((localStorage.getItem('theme') || 'light') === 'dark');

    function toggleTheme() {
      const isDark = !document.body.classList.contains('dark');
      applyTheme(isDark);
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    }
    themeToggleDesktop.addEventListener('click', toggleTheme);
    if (themeToggleMobile) themeToggleMobile.addEventListener('click', toggleTheme);

    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileSidebar = document.getElementById('mobileSidebar');
    const sidebarOverlay = document.getElementById('sidebarOverlay');
    const mobileSidebarClose = document.getElementById('mobileSidebarClose');
    function openSidebar() { mobileSidebar.classList.add('active'); sidebarOverlay.classList.add('active'); }
    function closeSidebar() { mobileSidebar.classList.remove('active'); sidebarOverlay.classList.remove('active'); }
    mobileMenuBtn.addEventListener('click', openSidebar);
    mobileSidebarClose.addEventListener('click', closeSidebar);
    sidebarOverlay.addEventListener('click', closeSidebar);
  </script>
</body>
</html>